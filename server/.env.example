# Desarrollo local. Copiar a server/.env y editar sin compartir secretos.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_MODE=pglite
PGLITE_DATA_DIR=.data/intermedios
SESSION_HOURS=8
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT=10

# PostgreSQL externo (obligatorio en producción). No desactivar validación TLS.
# DATABASE_MODE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/intermedios?sslmode=verify-full
# APP_ORIGINS=https://gestion.example.com

# Aprovisionamiento inicial únicamente: completar, ejecutar db:bootstrap y retirar.
# No usar las credenciales de demostración del frontend.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
